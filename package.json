{
  "name": "jarvis",
  "private": true,
  "description": "JARVIS: your financial second brain",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @jarvis/web",
    "build": "npm run build -w @jarvis/web",
    "start": "npm run start -w @jarvis/web",
    "lint": "npm run lint -w @jarvis/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @jarvis/web",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db.ts seed",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
