# Copy to .env at the repo root and fill in what you need. The app and the scripts both read it.
# Everything is optional: with nothing set, JARVIS runs on an embedded database, offline AI and demo data.

# ---------- Database ----------
# PostgreSQL with pgvector (see infrastructure/docker). Unset = embedded PGlite in .jarvis-data/.
DATABASE_URL=
# PGLITE_DATA_DIR=.jarvis-data/pglite

# ---------- Language model ----------
# anthropic | openai | local | mock. Unset = first configured key wins, else mock (offline mode).
AI_PROVIDER=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
# Required when AI_PROVIDER=openai
OPENAI_MODEL=
# OPENAI_BASE_URL=
# Local models through Ollama
# LOCAL_AI_URL=http://localhost:11434
# LOCAL_AI_MODEL=

# ---------- Embeddings ----------
# openai | local | hash. Unset = openai when OPENAI_API_KEY is set, else hash (offline).
EMBEDDING_PROVIDER=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LOCAL_EMBEDDING_MODEL=
# LOCAL_EMBEDDING_DIMENSIONS=

# ---------- Security ----------
# 32-byte key (base64) for encrypting broker credentials (Phase 3): openssl rand -base64 32
JARVIS_ENCRYPTION_KEY=
# Set to 1 to hide the one-click demo workspace on public deployments.
JARVIS_DISABLE_DEMO=

# ---------- Broker ----------
# Only "mock" exists in Phase 1. See docs/robinhood.md.
BROKER_PROVIDER=mock
